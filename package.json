{
  "name": "personnel-management-android",
  "version": "1.0.0",
  "private": true,
  "description": "مدیریت پرسنل — اپ اندروید (Capacitor)",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.js",
    "android:add": "npm run prepare:web && cap add android && node scripts/patch-android.js && capacitor-assets generate --android && cap sync android",
    "android:sync": "npm run prepare:web && cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^6.0.0",
    "@fontsource/vazirmatn": "^5.0.0"
  }
}
